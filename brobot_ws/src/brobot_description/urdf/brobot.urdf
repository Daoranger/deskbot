<?xml version="1.0"?>
<robot name="brobot">

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.11"/>
      </geometry>
      <material name="body_color">
        <color rgba="0.2 0.6 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.11"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0003786" ixy="0.0" ixz="0.0" iyy="0.0003786" iyz="0.0" izz="0.000253"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00000525" ixy="0.0" ixz="0.0" iyy="0.00000525" iyz="0.0" izz="0.000009375"/>
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.025" length="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.00000525" ixy="0.0" ixz="0.0" iyy="0.00000525" iyz="0.0" izz="0.000009375"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.05 -0.03" rpy="1.5708 0 0"/>
  </joint>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.05 -0.03" rpy="1.5708 0 0"/>
  </joint>

</robot>
