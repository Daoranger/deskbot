<?xml version="1.0"?>
<robot name="deskbot">

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.13</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.14 0.10 0.06"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.000453" ixy="0" ixz="0" iyy="0.000773" iyz="0" izz="0.000987"/>
    </inertial>
    <collision>
      <geometry>
        <box size="0.14 0.10 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Face -->
  <link name="left_pupil">
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.007"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="left_pupil_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_pupil"/>
    <origin xyz="0.071 0.03 0.005"/>
  </joint>

  <link name="right_pupil">
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.007"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="right_pupil_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_pupil"/>
    <origin xyz="0.071 -0.03 0.005"/>
  </joint>

  <link name="left_len">
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="left_len_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_len"/>
    <origin xyz="0.07 0.03 0.005"/>
  </joint>

  <link name="right_len">
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="right_len_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_len"/>
    <origin xyz="0.07 -0.03 0.005"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000129" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.0000129"/>
    </inertial>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.04 0.065 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000129" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.0000129"/>
    </inertial>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.04 -0.065 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Back Left Wheel -->
  <link name="back_left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000129" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.0000129"/>
    </inertial>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_wheel"/>
    <origin xyz="-0.04 0.065 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Back Right Wheel -->
  <link name="back_right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000129" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.0000129"/>
    </inertial>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_wheel"/>
    <origin xyz="-0.04 -0.065 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>